{
  "name": "github-extension-auth",
  "version": "0.1.0",
  "private": true,
  "description": "GitHub OAuth token-exchange Azure Function for the ADO extension",
  "main": "dist/auth/src/functions/*.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",

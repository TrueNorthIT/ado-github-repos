    "deploy": "node deploy.mjs"
  },
  "dependencies": {
    "@azure/functions": "^4.17.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}

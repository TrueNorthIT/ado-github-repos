{
  "manifestVersion": 1,
  "id": "github-repos",
  "version": "0.19.0",
  "name": "GitHub Repos",
  "description": "Lists and browses the GitHub repositories connected to a project, in its own GitHub Repos section.",
  "publisher": "TrueNorthIT",
  "public": false,
  "categories": ["Azure Repos"],
  "targets": [{ "id": "Microsoft.VisualStudio.Services" }],
  "icons": { "default": "images/icon.png" },
  "scopes": ["vso.githubconnections", "vso.work"],
  "files": [
    { "path": "dist", "addressable": true },
    { "path": "images/icon.png", "addressable": true },
    { "path": "images/github-mark-on-light.png", "addressable": true },
    { "path": "images/github-mark-on-dark.png", "addressable": true }
  ],
  "contributions": [
    {
      "id": "github-repos-hub-group",
      "type": "ms.vss-web.hub-group",
      "targets": ["ms.vss-web.project-hub-groups-collection"],
      "properties": {
        "name": "GitHub Repos",
        "order": 45,
        "icon": {
          "light": "images/github-mark-on-light.png",
          "dark": "images/github-mark-on-dark.png"
        }
      }
    },
    {
      "id": "github-repos-hub",
      "type": "ms.vss-web.hub",
      "targets": [".github-repos-hub-group"],
      "properties": {
        "name": "Repositories",
        "order": 1,
        "uri": "dist/hub.html",
        "iconName": "OpenSource"
      }
    },
    {
      "id": "github-repos-prs-hub",
      "type": "ms.vss-web.hub",
      "targets": [".github-repos-hub-group"],
      "properties": {
        "name": "Pull requests",
        "order": 2,
        "uri": "dist/hub.html",
        "iconName": "BranchPullRequest"
      }
    },
    {
      "id": "github-repos-breadcrumb",
      "type": "ms.vss-web.breadcrumb-provider",
      "targets": [".github-repos-hub", ".github-repos-prs-hub"],
      "properties": {
        "serviceName": "github-repos-breadcrumb",
        "registeredObjectId": "github-repos-breadcrumb",
        "breadcrumbId": "ms.vss-tfs-web.vertical-header-breadcrumb",
        "uri": "dist/breadcrumb.html"
      }
    }
  ]
}

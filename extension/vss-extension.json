{
  "manifestVersion": 1,
  "id": "github-repos",
  "version": "0.42.1",
  "name": "GitHub Repos",
  "description": "Lists and browses the GitHub repositories connected to a project, in its own GitHub Repos section.",
  "publisher": "TrueNorthIT",
  "public": false,
  "categories": ["Azure Repos"],
  "targets": [{ "id": "Microsoft.VisualStudio.Services" }],
  "icons": { "default": "images/icon.png" },
  "scopes": ["vso.githubconnections", "vso.project", "vso.work", "vso.work_write"],
  "files": [
    { "path": "dist", "addressable": true },
    { "path": "images/icon.png", "addressable": true },
    { "path": "images/github-mark-on-light.png", "addressable": true },
    { "path": "images/github-mark-on-dark.png", "addressable": true }
  ],
  "contributions": [
    {
      "id": "github-repos-hub-group",
      "type": "ms.vss-web.hub-group",
      "targets": ["ms.vss-web.project-hub-groups-collection"],
      "properties": {
        "name": "GitHub Repos",
        "order": 45,
        "icon": {
          "light": "images/github-mark-on-light.png",
          "dark": "images/github-mark-on-dark.png"
        }
      }
    },
    {
      "id": "github-repos-hub",
      "type": "ms.vss-web.hub",
      "targets": [".github-repos-hub-group"],
      "properties": {
        "name": "Files",
        "order": 1,
        "uri": "dist/hub.html",
        "iconName": "FileCode"
      }
    },
    {
      "id": "github-repos-commits-hub",
      "type": "ms.vss-web.hub",
      "targets": [".github-repos-hub-group"],
      "properties": {
        "name": "Commits",
        "order": 2,
        "uri": "dist/hub.html",
        "iconName": "BranchCommit"
      }
    },
    {
      "id": "github-repos-pushes-hub",
      "type": "ms.vss-web.hub",
      "targets": [".github-repos-hub-group"],
      "properties": {
        "name": "Pushes",
        "order": 3,
        "uri": "dist/hub.html",
        "iconName": "BranchShelveset"
      }
    },
    {
      "id": "github-repos-branches-hub",
      "type": "ms.vss-web.hub",
      "targets": [".github-repos-hub-group"],
      "properties": {
        "name": "Branches",
        "order": 4,
        "uri": "dist/hub.html",
        "iconName": "BranchFork2"
      }
    },
    {
      "id": "github-repos-tags-hub",
      "type": "ms.vss-web.hub",
      "targets": [".github-repos-hub-group"],
      "properties": {
        "name": "Tags & Releases",
        "order": 5,
        "uri": "dist/hub.html",
        "iconName": "Tag"
      }
    },
    {
      "id": "github-repos-prs-hub",
      "type": "ms.vss-web.hub",
      "targets": [".github-repos-hub-group"],
      "properties": {
        "name": "Pull requests",
        "order": 6,
        "uri": "dist/hub.html",
        "iconName": "BranchPullRequest"
      }
    },
    {
      "id": "github-repos-actions-hub",
      "type": "ms.vss-web.hub",
      "targets": [".github-repos-hub-group"],
      "properties": {
        "name": "Actions",
        "order": 7,
        "uri": "dist/hub.html",
        "iconName": "Rocket"
      }
    },
    {
      "id": "github-repos-security-hub",
      "type": "ms.vss-web.hub",
      "targets": [".github-repos-hub-group"],
      "properties": {
        "name": "Advanced Security",
        "order": 8,
        "uri": "dist/hub.html",
        "iconName": "Shield"
      }
    },
    {
      "id": "github-prs-widget",
      "type": "ms.vss-dashboards-web.widget",
      "targets": ["ms.vss-dashboards-web.widget-catalog", ".github-prs-widget-config"],
      "properties": {
        "name": "GitHub pull requests",
        "description": "Active pull requests in a connected GitHub repository: all, created by you or assigned to you.",
        "catalogIconUrl": "images/icon.png",
        "previewImageUrl": "images/icon.png",
        "uri": "dist/widget.html",
        "isNameConfigurable": true,
        "supportedSizes": [{ "rowSpan": 2, "columnSpan": 2 }, { "rowSpan": 2, "columnSpan": 3 }, { "rowSpan": 2, "columnSpan": 4 }],
        "supportedScopes": ["project_team"]
      }
    },
    {
      "id": "github-prs-widget-config",
      "type": "ms.vss-dashboards-web.widget-configuration",
      "targets": ["ms.vss-dashboards-web.widget-configuration"],
      "properties": {
        "name": "GitHub pull requests configuration",
        "description": "Choose the GitHub repository and which pull requests to show.",
        "uri": "dist/widget.html"
      }
    },
    {
      "id": "github-runs-widget",
      "type": "ms.vss-dashboards-web.widget",
      "targets": ["ms.vss-dashboards-web.widget-catalog", ".github-runs-widget-config"],
      "properties": {
        "name": "GitHub Actions history",
        "description": "Recent GitHub Actions runs of a workflow (or all of them) in a connected GitHub repository, and the last run's result.",
        "catalogIconUrl": "images/icon.png",
        "previewImageUrl": "images/icon.png",
        "uri": "dist/widget.html",
        "isNameConfigurable": true,
        "supportedSizes": [{ "rowSpan": 1, "columnSpan": 2 }, { "rowSpan": 2, "columnSpan": 2 }, { "rowSpan": 2, "columnSpan": 3 }, { "rowSpan": 2, "columnSpan": 4 }],
        "supportedScopes": ["project_team"]
      }
    },
    {
      "id": "github-runs-widget-config",
      "type": "ms.vss-dashboards-web.widget-configuration",
      "targets": ["ms.vss-dashboards-web.widget-configuration"],
      "properties": {
        "name": "GitHub Actions history configuration",
        "description": "Choose the GitHub repository and workflow.",
        "uri": "dist/widget.html"
      }
    },
    {
      "id": "github-my-prs-hub",
      "type": "ms.vss-web.hub",
      "targets": ["ms.vss-tfs-web.suite-me-page-hub-group"],
      "properties": {
        "name": "GitHub pull requests",
        "order": 100,
        "uri": "dist/hub.html",
        "iconName": "BranchPullRequest"
      }
    },
    {
      "id": "github-my-work-tab",
      "type": "ms.vss-web.tab",
      "targets": ["ms.vss-tfs-web.my-work-pivot"],
      "properties": {
        "name": "GitHub",
        "order": 1050,
        "uri": "dist/myWorkTab.html"
      }
    },
    {
      "id": "github-repos-breadcrumb",
      "type": "ms.vss-web.breadcrumb-provider",
      "targets": [".github-repos-hub", ".github-repos-commits-hub", ".github-repos-pushes-hub", ".github-repos-branches-hub", ".github-repos-tags-hub", ".github-repos-prs-hub", ".github-repos-security-hub"],
      "properties": {
        "serviceName": "github-repos-breadcrumb",
        "registeredObjectId": "github-repos-breadcrumb",
        "breadcrumbId": "ms.vss-tfs-web.vertical-header-breadcrumb",
        "uri": "dist/breadcrumb.html"
      }
    }
  ]
}
